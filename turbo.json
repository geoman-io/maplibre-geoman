{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "pnpm-lock.yaml",
    "turbo.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "*.tgz"
      ]
    },
    "build:types": {
      "dependsOn": [
        "^build:types"
      ],
      "outputs": [
        "dist/*.d.ts"
      ]
    },
    "ts": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/core/src/**",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/tests/**",
        "$TURBO_ROOT$/*.ts",
        "$TURBO_ROOT$/tsconfig*.json"
      ],
      "dependsOn": [
        "^ts"
      ],
      "outputs": []
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "outputs": []
    },
    "test": {
      "cache": false,
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "playwright-report/**",
        "test-results/**"
      ]
    },
    "test:unit": {
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "testserver": {
      "cache": false,
      "persistent": true
    }
  }
}
